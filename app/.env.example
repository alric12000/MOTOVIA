# Copy this file to .env and fill in your Firebase web app config.
# Firebase console → Project settings → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY= 
VITE_FIREBASE_AUTH_DOMAIN= 
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# AI auto-reply — SERVER-ONLY secrets for the Vercel functions in api/.
# Never prefix these with VITE_ (that would compile them into the browser bundle).
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# Locally: `vercel env pull .env.local`, then `vercel dev`.
# ---------------------------------------------------------------------------

# Firebase Admin: base64 of the service-account JSON
#   (Firebase console → Project settings → Service accounts → Generate new private key)
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
# Optional: named Firestore database (leave empty for "(default)")
FIREBASE_DATABASE_ID=
# Optional: restrict /api/send and /api/test-reply to these emails (comma-separated)
ADMIN_EMAILS=

# LLM — any OpenAI-compatible chat completions API (see README → "Switching LLM provider")
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# "none" keeps replies fast and stops hidden reasoning from using up max_tokens
LLM_REASONING_EFFORT=none
LLM_FALLBACK_REASONING_EFFORT=none

# Meta (Messenger, Instagram, WhatsApp) — see docs/SOCIAL_SETUP.md
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
PAGE_ACCESS_TOKEN=
# Instagram: leave empty to send via the linked Page (PAGE_ACCESS_TOKEN),
# or set both for the "Instagram API with Instagram Login" setup
IG_ACCESS_TOKEN=
IG_USER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# TikTok API for Business (comment replies) — see docs/SOCIAL_SETUP.md
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=
# Post public auto-replies under comments (otherwise comments are only collected)
TIKTOK_REPLY_TO_COMMENTS=false
